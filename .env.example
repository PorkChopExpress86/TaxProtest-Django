# Copy to .env and fill in. Everything here is read by docker-compose.yml and
# docker-compose.prod.yml; the container also receives the whole file via
# `env_file`. .env is gitignored and is NOT managed by the deploy pipeline --
# it must already exist on the server at $PROJECT_PATH/.env.

# --- Required (compose fails fast if unset) ---------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# --- Database ---------------------------------------------------------------
POSTGRES_USER=taxprotest
POSTGRES_DB=taxprotest

# --- Build ------------------------------------------------------------------
# 1 = build a normal-sized image and fetch HCAD archives at run time.
# 0 = bake ~1GB of HCAD archives into the image at build time. Baking also
#     changes the startup path: scripts/entrypoint.sh sees a new build stamp
#     and runs a full import_all_data before gunicorn starts (~11 min), so
#     every rebuild takes the site down for the duration. Prefer 1 unless the
#     server genuinely needs a self-contained image, since
#     counties/harris/var/downloads is bind-mounted from the host anyway.
SKIP_DATA_DOWNLOAD=1

# --- Web --------------------------------------------------------------------
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
WEB_CONCURRENCY=3

# Set these when running behind a TLS-terminating reverse proxy (see
# docs/REVERSE_PROXY.md). Leave at 0 for plain local HTTP, or the app will
# redirect to HTTPS and refuse to set cookies.
USE_X_FORWARDED_HOST=0
ENABLE_SECURE_PROXY_SSL_HEADER=0
FORCE_SECURE_COOKIES=0

# --- Runtime data directories ------------------------------------------------
# Defaults resolve inside the container; override only to relocate. See
# taxprotest/runtime_paths.py.
# HCAD_DOWNLOAD_DIR=/app/counties/harris/var/downloads
# HCAD_EXTRACT_DIR=/app/counties/harris/var/extracted
# HCAD_LOG_DIR=/app/counties/harris/var/logs
# PROJECT_REPORT_DIR=/app/counties/harris/var/reports
# BCAD_DOWNLOAD_DIR=/app/counties/brazos/var/downloads
# BCAD_EXTRACT_DIR=/app/counties/brazos/var/extracted

# --- Host user ----------------------------------------------------------------
# Containers run as this uid:gid so files written to the bind-mounted var/
# directories stay owned by the host user. Set with: UID=$(id -u) GID=$(id -g)
# UID=1000
# GID=1000
